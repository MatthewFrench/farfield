PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# VAPID Web Push contact subject (operator contact, not user-visible).
# Use a real contact even for localhost/LAN testing.
PUSH_VAPID_SUBJECT=mailto:you@example.com
API_TOKEN=
PUSH_DOCTOR_TOKEN=
