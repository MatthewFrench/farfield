{
  "name": "farfield",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/with-env.mjs \"node scripts/dev.mjs\"",
    "dev:remote": "node scripts/with-env.mjs \"node scripts/dev.mjs --remote\"",
    "build": "bun run --workspaces build",
    "test": "bun run --workspaces test",
    "lint": "bun run --workspaces lint",
    "typecheck": "bun run --workspaces typecheck",
    "premerge:check": "bun run lint && bun run typecheck && bun run test",
    "setup:ios-push": "node scripts/setup-ios-push.mjs",
    "setup:ntfy": "node scripts/setup-ntfy.mjs",
    "setup:domain-https": "node scripts/setup-domain-https.mjs",
    "ios:trust-local-ca": "node scripts/with-env.mjs \"node scripts/ios-trust-local-ca.mjs\"",
    "caddy:local": "node scripts/with-env.mjs \"node scripts/caddy-local.mjs\"",
    "rotate:api-token": "node scripts/with-env.mjs \"node scripts/rotate-api-token.mjs\"",
    "push:doctor": "node scripts/with-env.mjs \"node scripts/push-doctor.mjs\"",
    "smoke:app": "node scripts/with-env.mjs \"node scripts/app-smoke.mjs\"",
    "smoke:ios-device": "node scripts/with-env.mjs \"node scripts/ios-device-smoke.mjs\"",
    "smoke:ios-matrix": "node scripts/with-env.mjs \"node scripts/ios-device-smoke-matrix.mjs\"",
    "end-to-end:real:install": "bunx playwright install chromium",
    "end-to-end:real:run": "node scripts/with-env.mjs \"bun run --filter @farfield/protocol build && bunx playwright test -c playwright.real.config.ts\"",
    "end-to-end:real:ui": "node scripts/with-env.mjs \"bun run --filter @farfield/protocol build && bunx playwright test -c playwright.real.config.ts --ui\"",
    "end-to-end:real:debug": "node scripts/with-env.mjs \"bun run --filter @farfield/protocol build && bunx playwright test -c playwright.real.config.ts --debug\"",
    "stress:stream-burst": "node scripts/with-env.mjs \"node scripts/stream-burst.mjs\"",
    "verify:end-to-end:real": "bun run smoke:app && bun run end-to-end:real:run",
    "validate:end-to-end:governance": "node scripts/validate-end-to-end-governance.mjs",
    "sanitize:traces": "node scripts/sanitize-traces.mjs",
    "generate:codex-schema": "node scripts/generate-codex-schema.mjs",
    "screenshot:codex": "node skills/codex-window-debug/tools/codex-window-screenshot.mjs"
  },
  "devDependencies": {
    "@farfield/protocol": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  }
}
