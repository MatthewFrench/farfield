{
  "name": "@farfield/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch Source/Application/ServerBootstrap.ts",
    "dev:remote": "HOST=0.0.0.0 PORT=4311 tsx watch Source/Application/ServerBootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/Application/ServerBootstrap.js",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@farfield/api": "workspace:*",
    "@farfield/opencode-api": "workspace:*",
    "@farfield/protocol": "workspace:*",
    "pino": "^9.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  }
}
